load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "chunklist_proto",
    srcs = ["chunk_list.proto"],
    import_prefix = "github.com/buildbarn/bb-storage",
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "chunklist_go_proto",
    importpath = "github.com/buildbarn/bb-storage/pkg/proto/blobstore/chunklist",
    proto = ":chunklist_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "chunklist",
    embed = [":chunklist_go_proto"],
    importpath = "github.com/buildbarn/bb-storage/pkg/proto/blobstore/chunklist",
    visibility = ["//visibility:public"],
)
