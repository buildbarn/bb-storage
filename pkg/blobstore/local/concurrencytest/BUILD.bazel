load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "concurrencytest_test",
    srcs = [
        "flat_blob_access_concurrent_test.go",
        "persistent_block_list_concurrent_test.go",
        "refresh_concurrency_limit_test.go",
        "refresh_stripe_dedup_test.go",
        "volatile_block_list_concurrent_test.go",
    ],
    # These tests are most valuable under the race detector, but
    # `race = "on"` cannot be set here: //tools/platforms:host constrains
    # this repository to cgo_off, and race instrumentation needs cgo. Run
    # them under the detector explicitly with:
    #
    #   bazel test //pkg/blobstore/local/concurrencytest:all \
    #       --host_platform=@platforms//host \
    #       --@rules_go//go/config:race
    #
    deps = [
        "//pkg/blobstore/buffer",
        "//pkg/blobstore/local",
        "//pkg/capabilities",
        "//pkg/digest",
        "@bazel_remote_apis//build/bazel/remote/execution/v2:remote_execution_go_proto",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
